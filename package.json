{
  "name": "compass",
  "displayName": "Compass",
  "description": "VS Code workflow for C analysis, YAML generation, and HLS design-space exploration.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onView:compass-sidebar",
    "onCommand:compass.helloWorld",
    "onCommand:compass.debug-refresh",
    "onCommand:tdm.toggleCodeLens",
    "onCommand:tdm.toggleAutoDiscover",
    "onCommand:tdm.refreshAst",
    "onCommand:tdmOptimizer.toggleFunction",
    "onCommand:tdmOptimizer.toggleParam",
    "onCommand:tdmOptimizer.toggleLoopDirective",
    "onCommand:tdmOptimizer.addVariable",
    "onCommand:tdmOptimizer.toggleVariable"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "compass-sidebar-view",
          "title": "Compass",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "compass-sidebar-view": [
        {
          "type": "webview",
          "id": "compass-sidebar",
          "name": "Compass",
          "icon": "media/icon.svg",
          "contextualTitle": "Compass"
        }
      ]
    },
    "configuration": {
      "title": "Compass",
      "properties": {
        "compass.vivadoSettings64Path": {
          "type": "string",
          "default": "",
          "description": "Path to the Vivado/Vitis settings64.sh script to use when Compass cannot safely choose between different scripts for the same version."
        },
        "compass.hgboPythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python executable used to launch 3rdParty/HGBO-DSE. Point this at the Python 3.9 environment with HGBO-DSE dependencies installed."
        },
        "compass.remoteInferenceMcpEndpoint": {
          "type": "string",
          "default": "http://localhost:8000/mcp",
          "description": "MCP endpoint used for remote inference."
        }
      }
    },
    "commands": [
      {
        "command": "compass.helloWorld",
        "title": "Compass: Hello World"
      },
      {
        "command": "compass.debug-refresh",
        "title": "Compass: [Debug] Refresh"
      },
      {
        "command": "tdm.toggleCodeLens",
        "title": "Compass: Toggle CodeLens"
      },
      {
        "command": "tdm.toggleAutoDiscover",
        "title": "Compass: Toggle Auto Discovery"
      },
      {
        "command": "tdm.refreshAst",
        "title": "Compass: Refresh AST"
      },
      {
        "command": "tdmOptimizer.toggleFunction",
        "title": "Compass: Toggle Function in config.yaml"
      },
      {
        "command": "tdmOptimizer.toggleParam",
        "title": "Compass: Toggle Parameter in config.yaml"
      },
      {
        "command": "tdmOptimizer.toggleLoopDirective",
        "title": "Compass: Toggle Loop Directive in config.yaml"
      },
      {
        "command": "tdmOptimizer.addVariable",
        "title": "Compass: Add Variable to config.yaml"
      },
      {
        "command": "tdmOptimizer.toggleVariable",
        "title": "Compass: Toggle Variable in config.yaml"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run compile:webviews && pnpm run compile:extension",
    "compile:extension": "webpack",
    "compile:webviews": "rollup -c rollup.config.mjs",
    "watch": "concurrently \"rollup -c rollup.config.mjs -w\" \"webpack --watch\"",
    "package": "pnpm run compile:webviews && webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.118.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.3.0",
    "node-gyp": "^12.3.0",
    "node-loader": "^2.1.0",
    "postcss-load-config": "^6.0.1",
    "rollup": "^4.60.2",
    "rollup-plugin-css-only": "^4.5.5",
    "rollup-plugin-import-css": "^4.2.1",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-svelte": "7.2.3",
    "svelte": "^5.55.5",
    "svelte-preprocess": "^6.0.3",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "wasm-loader": "^1.3.0",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "js-yaml": "^4.1.1",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.2.4",
    "tree-sitter": "^0.25.0",
    "tree-sitter-c": "^0.24.1",
    "web-tree-sitter": "^0.26.8"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "pnpm": {
    "onlyBuiltDependencies": [
      "svelte-preprocess",
      "tree-sitter",
      "tree-sitter-c"
    ]
  }
}
