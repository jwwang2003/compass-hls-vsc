.gitmodules
.vscode/**
.vscode-test/**
.agents/**
.codex
.codex/**
.DS_Store
**/.DS_Store

# Dependency stores and caches
node_modules/**
.pnpm-store/**
.pytest_cache/**
**/.pytest_cache/**
**/__pycache__/**
**/*.pyc

# Source and test inputs compiled into runtime bundles
src/**
webviews/**
tests/**
out/test/**
**/*.ts
**/tsconfig.json

# Development configuration
eslint.config.mjs
postcss.config.js
tailwind.config.js
webpack.config.js
rollup.config.js
rollup.config.mjs
package-lock.json
pnpm-lock.yaml
yarn.lock
.yarnrc

# Build artifacts that are not loaded at runtime
**/*.map
dist/**/*.map
out/extension.js
out/analysis/**
out/parser/**
out/providers/**
out/services/**
out/states/**
out/utilities/**
out/compiled/CompassSidebar.*
out/compiled/HelloWorld.*
out/compiled/ProjectSettings.*
*.vsix

